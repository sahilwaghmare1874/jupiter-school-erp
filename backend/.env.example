# ─────────────────────────────────────────────────────────────────────────────
# Jupiter School ERP — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Django
SECRET_KEY=your-super-secret-production-key-change-this-before-going-live
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — in production, set to False and restrict CORS_ALLOWED_ORIGINS in settings.py
CORS_ALLOW_ALL=True

# Google Gemini AI (get your free key at https://aistudio.google.com/)
# Required for the JupiterAI assistant feature.
GEMINI_API_KEY=your-gemini-api-key-here

# Database — leave default for SQLite (development)
# Uncomment and set all values below to use PostgreSQL in production:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=jupiter_school_db
# DB_USER=jupiter_user
# DB_PASSWORD=strong_password_here
# DB_HOST=localhost
# DB_PORT=5432
